# Direct Video Uploader — Server Environment Variables
# Copy to .env and fill in values:  cp .env.example .env

# ─── Database ─────────────────────────────────────────────
# Local dev (Homebrew PostgreSQL):
# DATABASE_URL="postgresql://rodczaro@localhost:5432/directvideo"
#
# Render managed PostgreSQL (set automatically via render.yaml):
# DATABASE_URL="postgresql://user:pass@host:5432/directvideo"
DATABASE_URL=""

# ─── Auth ─────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# If not set, server generates a random one (sessions reset on restart).
JWT_SECRET=""

# ─── Server ───────────────────────────────────────────────
PORT=3000
HOST="0.0.0.0"
# NODE_ENV="production"  # Set automatically on Render

# ─── Slack Integration (Phase 3) ─────────────────────────
# SLACK_WEBHOOK_URL=""

# ─── Video Service (Phase 3) ─────────────────────────────
# MUX_TOKEN_ID=""
# MUX_TOKEN_SECRET=""

# ─── Cloud Storage (Phase 3) ─────────────────────────────
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
