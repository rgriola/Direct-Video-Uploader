# Direct Video Uploader — Server Environment Variables
# Copy to .env and fill in values:  cp .env.example .env

# ─── Database ─────────────────────────────────────────────
# Home server (Homebrew PostgreSQL 18, loopback + SCRAM):
# DATABASE_URL="postgresql://fixer_app:<urlencoded-pass>@127.0.0.1:5432/directvideo?sslmode=disable"
#
# Cloud Run + Cloud SQL (managed, set via Secret Manager):
DATABASE_URL="postgresql://user:pass@host:5432/directvideo"
# DATABASE_URL="ms-fixer-video-uploading:us-east4:ms-fixer-video-database-72026"

# ─── Auth ─────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# If not set, server generates a random one (sessions reset on restart).
JWT_SECRET=""
# Phone number (digits, as stored at signup) of the account to promote to SUPER_ADMIN.
# Applied by `npm run bootstrap:super-admin`; SUPER_ADMIN can't be granted through the API.
# SUPER_ADMIN_PHONE=""

# ─── Server ───────────────────────────────────────────────
PORT=3000
# Home server: HOST="127.0.0.1" (loopback only, exposed via Cloudflare Tunnel)
HOST="0.0.0.0"
# NODE_ENV="production"  # Set automatically on Cloud Run; set manually for home server

# Public-facing base URL (also used to derive the CORS/WebSocket allowlist, plus its
# "www." variant). Falls back to https://ms-fixer.com in production if unset.
# PUBLIC_URL="https://ms-fixer.com"
# Additional CORS/WebSocket origins beyond PUBLIC_URL and its www variant,
# comma-separated — e.g. a secondary hostname like the home-server dev subdomain.
# EXTRA_CORS_ORIGINS="https://dev.ms-fixer.com"

# ─── Slack Integration ────────────────────────────────────
# Create a Slack App → Bot Token Scopes: chat:write, users:read, im:write
# Install to workspace → copy Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=""

# ─── Mux Video ────────────────────────────────────────────
# API Access Token (create at dashboard.mux.com → Settings → API Access Tokens)
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
# Environment Key (for client-side Mux Player — dashboard.mux.com → Settings → Environments)
MUX_ENV_KEY=""
# Webhook signing secret (optional — for verifying webhook signatures)
# MUX_WEBHOOK_SECRET=""

# ─── Original-File Storage (Step 4) ───────────────────────
# The local driver defaults to server/.local-storage in development only.
# Production requires an explicit absolute path; keep originals outside the repo.
# STORAGE_DRIVER="local"
# STORAGE_LOCAL_ROOT="/Volumes/Originals"
#
# Experimental server-only upload sessions are disabled by default.
# Do not enable them on the home/production server: verified backups, cleanup
# validation, proactive alerts, proxy-log checks, isolated real-Mux validation,
# and client integration are still pending.
# UPLOAD_SESSIONS_ENABLED="false"
# Use a separate random secret of at least 32 bytes, never JWT_SECRET.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# UPLOAD_SESSION_SIGNING_SECRET=""
# Required positive decimal byte counts when upload sessions are enabled.
# Choose values for the actual storage root and volume; there are no defaults.
# UPLOAD_STORAGE_MAX_BYTES=""
# UPLOAD_STORAGE_MIN_FREE_BYTES=""
#
# Tracked upload-session cleanup is a separate opt-in and can run while upload
# intake is disabled. It requires the existing absolute local storage root;
# verify the actual mount, marker, and backups first. It logs untracked data for
# manual review and does not delete untracked directories. When monitoring is
# enabled, failed or stalled cycles appear in the dashboard and configured
# Slack alerts; deferred and untracked data still require log review.
# UPLOAD_SESSION_CLEANUP_ENABLED="false"
#
# Super Admin storage/backup monitoring is separately opt-in; see
# HOME_SERVER_RUNBOOK.md before configuring it. External alerts are off unless
# DVU_MONITOR_ALERT_SLACK_CHANNEL is set below.
# All paths must be absolute, and each warning free-space value must exceed
# its corresponding critical value. Values are bytes, not percentages.
# DVU_MONITORING_ENABLED="false"
# DVU_MONITOR_STATE_DIR=""
# DVU_MONITOR_SOURCE_VOLUME=""
# DVU_MONITOR_SOURCE_ID=""
# DVU_MONITOR_SOURCE_WARNING_FREE_BYTES=""
# DVU_MONITOR_SOURCE_CRITICAL_FREE_BYTES=""
# Required if UPLOAD_STORAGE_MAX_BYTES is set; must be below that limit.
# DVU_MONITOR_SOURCE_WARNING_USED_BYTES=""
# DVU_MONITOR_BACKUP_VOLUME=""
# DVU_MONITOR_BACKUP_ID=""
# DVU_MONITOR_BACKUP_WARNING_FREE_BYTES=""
# DVU_MONITOR_BACKUP_CRITICAL_FREE_BYTES=""
# DVU_MONITOR_DATABASE_VOLUME=""
# DVU_MONITOR_DATABASE_DIR=""
# DVU_MONITOR_DATABASE_WARNING_FREE_BYTES=""
# DVU_MONITOR_DATABASE_CRITICAL_FREE_BYTES=""
# Optional freshness limits; defaults are 3 hours, 36 hours, and 9 days.
# DVU_MONITOR_ORIGINAL_STALE_HOURS="3"
# DVU_MONITOR_DATABASE_LOCAL_STALE_HOURS="36"
# DVU_MONITOR_DATABASE_OFFSITE_STALE_HOURS="216"
# Optional Slack alerts for monitoring problems; requires SLACK_BOT_TOKEN and
# the bot in the channel. Channel name is lowercase without #. Unresolved
# problems repeat every 1-168 hours (default 6).
# DVU_MONITOR_ALERT_SLACK_CHANNEL=""
# DVU_MONITOR_ALERT_REPEAT_HOURS="6"
#
# The server-only Mux handoff is separately disabled by default.
# Requires upload sessions, Mux API credentials, and MUX_WEBHOOK_SECRET.
# Do not enable on the shared home server; the dev hostname is not isolated.
# MUX_ORIGINAL_INGEST_ENABLED="false"
# Use a third random secret (at least 32 bytes), distinct from both secrets above.
# MUX_ORIGINAL_READ_SIGNING_SECRET=""
# Absolute HTTPS origin of an isolated backend; no path or query.
# MUX_ORIGINAL_READ_BASE_URL="https://isolated.example.test"
# Default 3600 seconds; supported range 300 to 86400.
# MUX_ORIGINAL_READ_TTL_SECONDS="3600"
# Never set DEBUG=true: the Mux SDK can log signed original-read URLs.

# ─── Cloud Storage (future) ───────────────────────────────
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
