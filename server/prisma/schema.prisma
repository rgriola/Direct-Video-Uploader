// Direct Video Uploader — Prisma Schema
// PostgreSQL on Render

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Organizations ───────────────────────────────────────
model Organization {
  id          String   @id @default(uuid())
  companyName String   @map("company_name") @db.VarChar(50)
  companyCode String   @unique @map("company_code") @db.VarChar(4)
  createdAt   DateTime @default(now()) @map("created_at")

  users User[]

  @@map("organizations")
}

// ─── Users ───────────────────────────────────────────────
model User {
  id          String     @id @default(uuid())
  phoneNumber String     @unique @map("phone_number")
  name        String
  email       String?
  team        String?
  companyCode String?    @map("company_code") @db.VarChar(4)
  pinHash     String     @map("pin_hash")
  role        UserRole   @default(USER) @map("role")
  status      UserStatus @default(ACTIVE)
  pausedAt    DateTime?  @map("paused_at")
  pausedById  String?    @map("paused_by_id")
  lastLoginAt DateTime?  @map("last_login_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [companyCode], references: [companyCode])
  assets       Asset[]
  messages     ChatMessage[]
  uploadSessions UploadSession[]
  originalUploadIntents OriginalUploadIntent[]

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

// ─── Assets (video upload groups) ────────────────────────
model Asset {
  id               String      @id @default(uuid())
  userId           String      @map("user_id")
  mediasourceId    String?     @unique @map("mediasource_id")
  mediasourceUrl   String?     @map("mediasource_url")
  originalFileName String?     @map("original_file_name")
  clipCount        Int         @default(0) @map("clip_count")
  totalDuration    Int         @default(0) @map("total_duration_seconds")
  status           AssetStatus @default(UPLOADING)
  uploadMode       AssetUploadMode? @map("upload_mode")
  originalIntentSizeBytes Int? @map("original_intent_size_bytes")
  originalIntentSha256 String? @map("original_intent_sha256") @db.VarChar(64)
  moderation       AssetModeration @default(ACTIVE)
  moderatedAt      DateTime?   @map("moderated_at")
  moderatedById    String?     @map("moderated_by_id")
  moderationReason String?     @map("moderation_reason")
  mediaSyncState   MediaSyncState @default(PENDING) @map("media_sync_state")
  mediaSyncError   String?     @map("media_sync_error")
  mediaSyncRevision Int        @default(0) @map("media_sync_revision")
  mediaSyncNextAt  DateTime?   @default(now()) @map("media_sync_next_at")
  mediaPlaybackReset Boolean   @default(false) @map("media_playback_reset")
  mediaCreateOperationId String? @map("media_create_operation_id")
  mediaCreateMuxAssetId String? @map("media_create_mux_asset_id")
  mediaCreateStartedAt DateTime? @map("media_create_started_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id])
  clips        Clip[]
  uploadSessions UploadSession[]
  originalUploadIntent OriginalUploadIntent?
  muxAssetReferences MuxAssetReference[]
  originalReadLeases MuxOriginalReadLease[]
  formResponse FormResponse?
  messages     ChatMessage[]

  @@index([userId])
  @@index([moderation, createdAt])
  @@index([mediaSyncState, mediaSyncNextAt])
  @@index([moderation, mediaSyncNextAt])
  @@map("assets")
}

enum AssetStatus {
  UPLOADING
  PROCESSING
  READY
  ERROR
}

enum AssetUploadMode {
  MUX
  ORIGINAL
}

enum AssetModeration {
  ACTIVE
  PAUSED
  FLAGGED_FOR_REMOVAL
  REMOVED
}

model OriginalUploadIntent {
  userId          String    @map("user_id")
  clientRequestId String    @map("client_request_id") @db.Uuid
  assetId         String?   @unique @map("asset_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  cancelledAt     DateTime? @map("cancelled_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@id([userId, clientRequestId])
  @@map("original_upload_intents")
}

enum MediaSyncState {
  PENDING
  SYNCED
  ERROR
}

model MuxAssetReference {
  muxAssetId String @id @map("mux_asset_id")
  assetId    String @map("asset_id")
  clipId     String? @map("clip_id")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("mux_asset_references")
}

enum AuditTargetType {
  USER
  ASSET
}

model AuditLog {
  id          String          @id @default(uuid())
  actorUserId String          @map("actor_user_id")
  targetType  AuditTargetType @map("target_type")
  targetId    String          @map("target_id")
  action      String          @db.VarChar(50)
  reason      String?
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([targetType, targetId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

// ─── Clips (individual video files) ──────────────────────
model Clip {
  id               String     @id @default(uuid())
  assetId          String     @map("asset_id")
  clipIndex        Int        @default(0) @map("clip_index")
  originalFileName String?    @map("original_file_name")
  storageUrl       String?    @map("storage_url")
  storageKey       String?    @unique @map("storage_key")
  storageDriver    String?    @map("storage_driver")
  sha256           String?    @db.VarChar(64)
  streamUrl        String?    @map("stream_url")
  thumbnailUrl     String?    @map("thumbnail_url")
  muxAssetId       String?    @map("mux_asset_id")
  muxPlaybackId    String?    @map("mux_playback_id")
  muxUploadId      String?    @map("mux_upload_id")
  gpsLat           Float?     @map("gps_lat")
  gpsLon           Float?     @map("gps_lon")
  gpsAltitude      Float?     @map("gps_altitude")
  capturedAt       DateTime?  @map("captured_at")
  deviceModel      String?    @map("device_model")
  osVersion        String?    @map("os_version")
  codec            String?
  resolution       String?
  orientation      String?    @default("landscape")
  duration         Int?       @map("duration_seconds")
  fileSize         BigInt?    @map("file_size_bytes")
  transcript       String?    @map("transcript")
  transcriptSegments Json?    @map("transcript_segments")
  status           ClipStatus @default(UPLOADING)
  createdAt        DateTime   @default(now()) @map("created_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  uploadSessions UploadSession[]

  @@index([assetId])
  @@map("clips")
}

enum ClipStatus {
  UPLOADING
  PROCESSING
  READY
  ERROR
}

enum UploadSessionStatus {
  OPEN
  COMPLETING
  COMPLETED
  ABORTED
  EXPIRED
}

model UploadSession {
  id                String              @id
  ownerId           String              @map("owner_id")
  assetId           String              @map("asset_id")
  clipId            String              @map("clip_id")
  storageDriver     String              @default("local") @map("storage_driver")
  storageKey        String              @unique @map("storage_key")
  expectedSizeBytes BigInt?             @map("expected_size_bytes")
  expectedSha256    String?             @map("expected_sha256") @db.VarChar(64)
  storageReservationBytes BigInt?       @map("storage_reservation_bytes")
  status            UploadSessionStatus @default(OPEN)
  expiresAt         DateTime            @map("expires_at")
  completedAt       DateTime?           @map("completed_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  owner  User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  asset  Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  clip   Clip         @relation(fields: [clipId], references: [id], onDelete: Cascade)
  parts  UploadPart[]
  muxIngestJob MuxIngestJob?

  @@index([ownerId, status, expiresAt])
  @@index([assetId, status])
  @@index([assetId, id])
  @@index([clipId, status])
  @@map("upload_sessions")
}

// A lease must outlive a deleted session until its writer is known to have stopped.
model StorageWriteLease {
  id              String   @id
  uploadSessionId String   @map("upload_session_id")
  storageIdentity String   @map("storage_identity")
  sizeBytes       BigInt   @map("size_bytes")
  host            String
  pid             Int
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([uploadSessionId])
  @@map("storage_write_leases")
}

model UploadPart {
  uploadSessionId String   @map("upload_session_id")
  partNumber      Int      @map("part_number")
  sizeBytes       BigInt   @map("size_bytes")
  sha256          String   @db.VarChar(64)
  uploadedAt      DateTime @default(now()) @map("uploaded_at")

  uploadSession UploadSession @relation(fields: [uploadSessionId], references: [id], onDelete: Cascade)

  @@id([uploadSessionId, partNumber])
  @@index([uploadedAt])
  @@map("upload_parts")
}

enum MuxIngestJobStatus {
  QUEUED
  CREATING
  LINKED
  FAILED
  UNKNOWN
  CONFLICT
}

enum MuxIngestAttemptStatus {
  CREATING
  LINKED
  REJECTED
  UNKNOWN
  CONFIRMED_ABSENT
}

model MuxIngestJob {
  uploadSessionId String             @id @map("upload_session_id")
  status          MuxIngestJobStatus @default(QUEUED)
  attemptCount    Int                @default(0) @map("attempt_count")
  retryCount      Int                @default(0) @map("retry_count")
  currentAttemptId String?           @map("current_attempt_id")
  nextAttemptAt   DateTime?          @default(now()) @map("next_attempt_at")
  lastError       String?            @map("last_error")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  uploadSession UploadSession       @relation(fields: [uploadSessionId], references: [id], onDelete: Cascade)
  attempts      MuxIngestAttempt[]

  @@index([status, nextAttemptAt])
  @@map("mux_ingest_jobs")
}

model MuxIngestAttempt {
  id              String                 @id
  uploadSessionId String                 @map("upload_session_id")
  status          MuxIngestAttemptStatus @default(CREATING)
  readExpiresAt   DateTime               @map("read_expires_at")
  muxAssetId      String?                @map("mux_asset_id")
  createdAt       DateTime               @default(now()) @map("created_at")
  resolvedAt      DateTime?              @map("resolved_at")

  job MuxIngestJob @relation(fields: [uploadSessionId], references: [uploadSessionId], onDelete: Cascade)
  readLeases MuxOriginalReadLease[]

  @@index([uploadSessionId, status])
  @@index([muxAssetId])
  @@map("mux_ingest_attempts")
}

model MuxOriginalReadLease {
  id               String   @id
  assetId          String   @map("asset_id")
  attemptId        String   @map("attempt_id")
  serverInstanceId String   @map("server_instance_id")
  createdAt        DateTime @default(now()) @map("created_at")

  asset   Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  attempt MuxIngestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([assetId, createdAt])
  @@map("mux_original_read_leases")
}

// ─── Form Responses ──────────────────────────────────────
model FormResponse {
  id          String   @id @default(uuid())
  assetId     String   @unique @map("asset_id")
  slug        String?
  type        String? // Raw, Interview, Standup, Other
  description String?
  priority    Priority @default(MEDIUM)
  extra       Json?    @map("additional_data")
  submittedAt DateTime @default(now()) @map("submitted_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("form_responses")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ─── Chat Messages ───────────────────────────────────────
model ChatMessage {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  assetId     String?     @map("asset_id")
  direction   Direction
  messageType MessageType @map("message_type")
  content     Json
  createdAt   DateTime    @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id])
  asset Asset? @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("chat_messages")
}

enum Direction {
  OUTGOING
  INCOMING
}

enum MessageType {
  VIDEO
  FORM_REQUEST
  FORM_SUBMITTED
  CONFIRMATION
  SLACK_POST
  TEXT
  GREETING
}

// ─── Error Log (for future text/email notifications) ─────
model ErrorLog {
  id        String        @id @default(uuid())
  userId    String?       @map("user_id")
  assetId   String?       @map("asset_id")
  source    String // "ios", "server", "dashboard"
  category  String // "upload", "form", "websocket", "auth"
  message   String
  details   Json? // stack trace, request info, etc.
  severity  ErrorSeverity @default(WARNING)
  notified  Boolean       @default(false) // future: set true after text/email sent
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("error_logs")
}

enum ErrorSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}
